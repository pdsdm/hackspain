{
  "name": "hackspain-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch --import tsx src/server.ts",
    "start": "node --env-file-if-exists=../.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "coordinator": "node --env-file-if-exists=../.env --import tsx src/agents/coordinator/run.ts",
    "coordinator:happyrobot": "node --env-file-if-exists=../.env --import tsx src/agents/coordinator/run-happyrobot.ts",
    "demo:video": "node --env-file-if-exists=../.env --import tsx ../scripts/demo-video.mts",
    "lint": "cd .. && backend/node_modules/.bin/oxlint backend/src backend/test backend/fixtures scripts/generate-fixtures.mts scripts/setup-happyrobot-demo-inputs.mts scripts/demo-video.mts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "fixtures:generate": "node --import tsx ../scripts/generate-fixtures.mts",
    "fixtures:check": "tsc -p tsconfig.fixtures.json && node --import tsx ../scripts/generate-fixtures.mts --check"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "oxlint": "^1.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
