# --- LLM / Agentes ---
# Cognition/Devin es el proveedor por defecto (D12). Token cog_ de Service Users.
COGNITION_API_KEY=
# Alias del mismo token.
DEVIN_API_KEY=
# Endpoint OpenAI-compatible de SWE. Si Cognition te dio otra URL, ponla aquí.
COGNITION_API_BASE=https://api.cognition.ai/v1
# tools = function calling local (recomendado). json = bucle D11. devin = sesión cloud.
COORDINATOR_HARNESS=tools
# Obligatorio si COORDINATOR_HARNESS=devin (Settings → Service Users).
DEVIN_ORG_ID=
# Alias de DEVIN_ORG_ID.
COGNITION_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai/v3
DEVIN_MODE=fast
# 1/true: pide response_format json_object en el harness json (solo proveedores que lo soporten).
COORDINATOR_JSON_OBJECT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HELMCODE_API_KEY=
# Verificación semántica de aceptaciones en callbacks de HappyRobot.
JEV_ENABLED=false
JEV_APPLY_CONFIRMATIONS=
JEV_REVIEWED_TRANSCRIPT_HASHES=
JEV_LIVE_EVAL=
JEV_EVAL_VARIANT=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Compatible con OpenAI. Helmcode: https://api.helmcode.com/v1
OPENAI_BASE_URL=
# Vacío: swe-1.7 (Cognition), gpt-4o-mini, claude haiku o deepseek-v4-flash.
COORDINATOR_MODEL=

# --- Backend ---
HOST=
PORT=8000
DATABASE_URL=
INITIAL_FIXTURE=calm
CLOCK_SPEED=
COORDINATOR_MODE=
PUBLIC_BASE_URL=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_DATA_SOURCE=sim

# --- HappyRobot ---
HAPPYROBOT_API_KEY=
HAPPYROBOT_WEBHOOK_TOKEN=
HAPPYROBOT_HOOK_ESPACIOS=
HAPPYROBOT_HOOK_CATERING=
HAPPYROBOT_HOOK_TRANSPORTE=
HAPPYROBOT_HOOK_ASISTENTES=
QUIVERAI_API_KEY=
