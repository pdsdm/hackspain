# --- LLM / Agentes ---
# Cognition/Devin es el proveedor por defecto (D12). Token cog_ de Service Users.
COGNITION_API_KEY=
# Alias del mismo token.
DEVIN_API_KEY=
# Endpoint OpenAI-compatible de SWE. Si Cognition te dio otra URL, ponla aquí.
COGNITION_API_BASE=https://api.cognition.ai/v1
# tools = function calling local (recomendado). json = bucle D11. devin = sesión cloud.
COORDINATOR_HARNESS=tools
# Obligatorio si COORDINATOR_HARNESS=devin (Settings → Service Users).
DEVIN_ORG_ID=
# Alias de DEVIN_ORG_ID.
COGNITION_ORG_ID=
DEVIN_API_BASE=https://api.devin.ai/v3
DEVIN_MODE=fast
# 1/true: pide response_format json_object en el harness json (solo proveedores que lo soporten).
COORDINATOR_JSON_OBJECT=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HELMCODE_API_KEY=
# Verificación semántica de aceptaciones en callbacks de HappyRobot.
JEV_ENABLED=false
JEV_APPLY_CONFIRMATIONS=
JEV_REVIEWED_TRANSCRIPT_HASHES=
# Manda a JEV transcripciones sin revisar. Solo con datos sintéticos: en la demo el sim-world
# genera diálogo natural que el vocabulario revisado nunca acepta.
JEV_ALLOW_UNREVIEWED_TRANSCRIPTS=
# Techo de la evaluación en ms (200-15000, por defecto 3000). Con 1500 se perdía 1 de cada 2.
JEV_TIMEOUT_MS=
JEV_LIVE_EVAL=
JEV_EVAL_VARIANT=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Compatible con OpenAI. Helmcode: https://api.helmcode.com/v1
OPENAI_BASE_URL=
# Vacío: swe-1.7 (Cognition), gpt-4o-mini, claude haiku o deepseek-v4-flash.
COORDINATOR_MODEL=
# none | low | medium | high. En Helmcode/DeepSeek se manda también thinking.enabled; low recorta CoT si el proveedor lo honra. El prompt impide redactar el JSON en el thinking.
# Vacío con Helmcode ya vale: el backend usa low por defecto (medido en D15). Con none los
# planes salen en 7 s pero dejan invitados sin asignar. Los demás proveedores no reciben nada.
COORDINATOR_REASONING_EFFORT=
# Vacío o 1: imprime thinking/answer en vivo (SSE). 0 para silenciar.
COORDINATOR_VERBOSE=

# --- Backend ---
HOST=
PORT=8000
DATABASE_URL=
# Persistencia en Postgres (proyecto pdsdm's Project). El motor sigue en SQLite;
# con estas dos variables el backend hidrata y copia runs, tareas y eventos.
# Service role: Dashboard → Project Settings → API. Nunca en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INITIAL_FIXTURE=calm
CLOCK_SPEED=
SIM_INCIDENTS=
SIM_SEED=
COORDINATOR_MODE=
# Base del callbackUrl que se manda a HappyRobot. Tiene que ser una URL pública que llegue
# a este backend (ngrok, cloudflared): con localhost el callback no vuelve nunca y cada
# llamada acaba en no_answer a los 180 s de reloj. Los túneles caducan; revísalo al empezar.
PUBLIC_BASE_URL=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000
VITE_DATA_SOURCE=sim

# --- HappyRobot ---
# open = el LLM inventa cada incidencia del Modo vivo; catalog = lista fija de incidents.ts
SIM_INCIDENTS_MODE=
HAPPYROBOT_API_KEY=
HAPPYROBOT_TEST_PHONE=
HAPPYROBOT_WEBHOOK_TOKEN=
# URL del trigger Webhook de cada workflow. OJO con el host: el que da el builder en la
# barra del navegador (platform.happyrobot.ai) devuelve 307 a /auth/login y el fetch de
# Node muere con "fetch failed". El que funciona es el de workflows:
#   https://workflows.platform.eu.happyrobot.ai/hooks/<id-del-workflow>
HAPPYROBOT_HOOK_ESPACIOS=
HAPPYROBOT_HOOK_CATERING=
HAPPYROBOT_HOOK_TRANSPORTE=
HAPPYROBOT_HOOK_ASISTENTES=
QUIVERAI_API_KEY=
