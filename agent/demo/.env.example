
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+16105358843

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public host for webhooks (must be HTTPS + WSS in production)
PUBLIC_HOST=tu-url-ngrok.ngrok-free.dev

# Optional: phone number for human participant in conference
HUMAN_PHONE_NUMBER=+34XXXXXXXXX

# Demo (opcional)
CALL_MODE=direct            # direct | conference
REALTIME_MODEL=gpt-realtime-mini
REALTIME_VOICE=marin

# Sala de varias personas (/conference/start). E.164, separados por coma.
# Si está vacío, se usa HUMAN_PHONE_NUMBER.
CONFERENCE_PARTICIPANTS=+34600000000,+34600000001
# Token de los endpoints que crean llamadas. Déjalo vacío solo en local.
DEMO_API_TOKEN=
